# --- Entorno: local | pre | prod ---
# Sin esto, Vercel preview = pre y production = prod. En el portátil: local.
APP_ENV=local

# --- Base de datos ---
# SQLite en desarrollo. Para migrar a PostgreSQL, cambia el provider en
# prisma/schema.prisma y pon aquí la URL del servidor.
DATABASE_URL="file:./dev.db"

# --- Autenticación ---
# auto  = usa Auth0 si están las cuatro variables, si no modo local
# local = fuerza el modo local (útil mientras el tenant no está configurado)
# auth0 = fuerza Auth0. Obligatorio en pre y prod.
AUTH_MODE=local

# demo = el panel ⌘J muestra la conversación de ejemplo, sin modelo ni escrituras.
# vacío = agente real si hay clave y modelo; si no, el panel dice «IA no configurada».
NEXT_PUBLIC_AI_PANEL=demo

# --- Asistente (AI Gateway) ---
# Sin AI_GATEWAY_API_KEY el panel no llama a ningún modelo.
# C4M_AI_MODEL es un id proveedor/modelo del catálogo (https://ai-gateway.vercel.sh/v1/models).
# En local, C4M_AI_MODEL=mock/local usa un modelo simulado (no sale a la red).
# C4M_AI_FALLBACK_MODEL se prueba si el principal falla.
# TOOL_APPROVAL_SECRET es obligatoria (openssl rand -base64 32, 32 bytes o más).
# Sin ella el panel dice «IA no configurada» y POST /api/agent responde 503.
# C4M_AI_RATE_PER_MINUTE limita por usuario en este proceso (defecto 20).
AI_GATEWAY_API_KEY=
C4M_AI_MODEL=
C4M_AI_FALLBACK_MODEL=
TOOL_APPROVAL_SECRET=
C4M_AI_MAX_STEPS=8
C4M_AI_RATE_PER_MINUTE=20

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:43127

# --- Semilla local ---
# Correo del administrador que crea prisma/seed.ts
BOOTSTRAP_ADMIN_EMAIL="alvaroromero@creatorsformedia.com"

# --- Datos de la empresa que firma los contratos ---
COMPANY_LEGAL_NAME="Creators For Media, S.L."
COMPANY_TAX_ID="B00000000"
COMPANY_ADDRESS="Calle Ejemplo 1, 28001 Madrid, España"
COMPANY_EMAIL="finanzas@creatorsformedia.com"

# --- Correo transaccional (opcional) ---
# Sin API key se genera el enlace y se copia. Con ella, Resend manda firma e invitaciones.
RESEND_API_KEY=
MAIL_FROM="Creators For Media <finanzas@creatorsformedia.com>"
