# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.pre.example
!.env.prod.example

# vercel
.vercel

# Neon: puntero local de proyecto/rama (sin secretos). Las credenciales viven en ~/.config/neon
.neon

# base de datos local de desarrollo
/prisma/*.db
/prisma/*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts
