    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
